---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { t } from '../../i18n';
---

<BaseLayout
  title={t('about.title')}
  description={`About the author behind this ${SITE.title} site.`}
>
  <section class="page-head section">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1>Who I Am</h1>
    <p class="lead">
      Self-taught IT practitioner based in Southern California, with a background
      in Cybersecurity. DoD 8140 IAT Level II certified.
    </p>
  </section>

    <section class="section">
    <p class="eyebrow">Credentials</p>
    <div class="credentials-grid">
      <a href="https://www.credly.com/badges/b6ee5f9a-3481-4fa3-a6a6-bc4db0c20a0f" target="_blank" rel="noopener noreferrer" class="credential-card">
        <img src="/badges/cysa-plus.png" alt="CompTIA CySA+ badge" />
        <p class="credential-name">CompTIA CySA+</p>
        <p class="credential-issuer">CompTIA</p>
      </a>
      <a href="https://www.credly.com/badges/88cb523c-f6f9-444c-8a4b-d81fd6519ffe" target="_blank" rel="noopener noreferrer" class="credential-card">
        <img src="/badges/google-cybersecurity.png" alt="Google Cybersecurity Professional badge" />
        <p class="credential-name">Google Cybersecurity Professional</p>
        <p class="credential-issuer">Google / Coursera</p>
      </a>
      <a href="https://learn.microsoft.com/api/credentials/share/en-us/JosephDeSantiago-3317/1969E8EF3A7328F3?sharingId=BDD2D0FC710263F8" target="_blank" rel="noopener noreferrer" class="credential-card">
        <img src="/badges/microsoft-applied-skills.png" alt="Microsoft Applied Skills badge" />
        <p class="credential-name">Applied Skills: Microsoft Entra</p>
        <p class="credential-issuer">Microsoft</p>
      </a>
      <a href="https://www.credly.com/badges/792e2499-fcd7-4733-bc5e-581c952f195d" target="_blank" rel="noopener noreferrer" class="credential-card">
        <img src="/badges/cisco-support.png" alt="Cisco IT Customer Support Basics badge" />
        <p class="credential-name">IT Customer Support Basics</p>
        <p class="credential-issuer">Cisco</p>
      </a>
    </div>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Background</p>
      <h2>//</h2>
    </div>
    <div class="prose-stack">
      <p>
        I have hands-on experience with Windows Active Directory and Microsoft 365
        environments, Linux and macOS, identity and access management, endpoint
        configuration and management, ITSM platforms, and systems hardening.
        Built through practical lab work and professional experience.
      </p>
      <p>
        Understanding how systems fail and how they are exploited allows me to be
        effective at maintaining them. I resolve problems fast, escalate with
        coherent context, and catch issues that might be overlooked without a
        strong security perspective.
      </p>
      <p>
        IT and Cybersecurity exist to keep people productive in a safe, efficient
        environment. That perspective allows me to communicate clearly across
        technical and non-technical teams.
      </p>
    </div>
  </section>

  <section class="section" aria-label={t('about.ledgerLabel')}>
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Current focus</h3>
        <p>
          Enterprise IT support and administration, with active self-directed
          study in networking through Cisco CCNA preparation.
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Motto</h3>
        <p>When in doubt, read the friendly manual.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Contact</h3>
        <p>Reach me through Email or LinkedIn.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .credential-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    gap: 0.75rem;
    transition: opacity 0.2s ease;
  }

  .credential-card:hover {
    opacity: 0.8;
  }

  .credential-card img {
    width: 120px;
    height: 120px;
    object-fit: contain;
  }

  .credential-name {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0;
    color: inherit;
  }

  .credential-issuer {
    font-size: 0.75rem;
    margin: 0;
    opacity: 0.6;
  }
</style>